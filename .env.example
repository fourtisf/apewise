# Public site URL — used for canonical/OG/sitemap absolute URLs.
NEXT_PUBLIC_SITE_URL=https://apewise.ai

# Every /api/waitlist signup is appended to a durable local JSONL file
# (default ./data/waitlist.jsonl — gitignored, survives restarts + deploys).
# Uncomment to store it somewhere else.
# WAITLIST_FILE=/var/www/apewise/data/waitlist.jsonl

# Optional: ALSO forward each validated signup to this webhook (Sheets/Zapier/CRM/ESP).
WAITLIST_WEBHOOK_URL=

# Optional analytics (privacy-friendly Plausible). Set to your site domain to enable
# pageviews + the "Waitlist Signup" goal. Leave unset to disable analytics entirely.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=apewise.ai
# Self-hosted Plausible only — full script URL:
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# ───────────────────────── MVP: smart-money engine (Solana / Helius) ─────────
# Without these, the /terminal stays in DEMO mode and no alerts are sent.
#
# CHOOSE ONE INGEST MODE — do NOT run both:
#   A) Webhook (recommended): Helius PUSHES swaps only when a tracked wallet
#      trades. Scales to 100s of wallets cheaply — you pay per real swap, not
#      per poll. Set HELIUS_API_KEY + run setup-helius-webhook.mjs, and do NOT
#      run the apewise-rpc worker (pm2 stop apewise-rpc).
#   B) RPC poll (free fallback): the apewise-rpc worker PULLS every wallet every
#      cycle (see the bottom section). Use a FREE public RPC for this — pointing
#      it at a paid Helius RPC burns credits even when nothing trades.
#
# Helius API key — creates the webhook + provides RPC. https://helius.xyz
HELIUS_API_KEY=
# Public URL of the ingest endpoint (used by scripts/setup-helius-webhook.mjs)
WEBHOOK_URL=https://apewise.ai/api/ingest/helius
# Shared secret: Helius sends it as the webhook authHeader; /api/ingest/helius checks it.
INGEST_SECRET=
# Telegram bot that posts to the signals channel, + the channel/chat id (e.g. @apewisesignals)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SIGNALS_CHAT_ID=@apewisesignals
# Webhook secret for the bot command handler (any random string)
TELEGRAM_WEBHOOK_SECRET=
# Channel alerts (Telegram): quality gate + worker poll interval
# ALERT_MIN_USD=1000              # min trade size to broadcast — applies to BUYS AND SELLS (kills dust like a $25 sell)
# ALERT_WALLET_COOLDOWN_SEC=90    # min seconds between alerts from the SAME wallet (any token) — stops one wallet spamming a wall of near-identical alerts. 0 disables
# ALERT_WHALE_USD=25000           # at/above this a trade is framed as a "Whale ..."; below it "Smart money ..." (so a $25 trade is never called a whale)
# ALERT_BUYS_ONLY=false           # set "true" to only post buys (Moby-style), never sells
# ALERT_INTERVAL_SEC=60
# Optional referral "Buy" link template ({mint} is replaced). Defaults to a DexScreener link.
# BUY_LINK_TEMPLATE=https://t.me/your_trojan_bot?start={mint}
# Optional overrides
# SOL_PRICE_USD=150
# SMART_WALLETS_FILE=data/smart-wallets.json
# EVENTS_FILE=data/events.jsonl
# Anti-rug / alert tuning
# MIN_LIQUIDITY_USD=5000          # below this, a token is flagged "caution"
# ALERT_COOLDOWN_SEC=60           # min seconds between alerts for the same wallet+token
# ALERT_ON_RISK=false             # set "true" to alert even on high-risk tokens
# MIN_TRADE_USD=50                # live-market feed: hide trades smaller than this
# ── Wallet sourcing for scripts/source-wallets.mjs (it loads THIS file itself) ──
# BEST for "high win-rate": Solana Tracker — free key at solanatracker.io, no Cloudflare, ranks wallets by win %
# SOLANATRACKER_API_KEY=          # enables the win-rate leaderboard source (recommended)
# SOLANATRACKER_LIMIT=150         # how many high-win-rate wallets to source
# SOLANATRACKER_MIN_WINRATE=55    # only wallets with win % >= this
# SOLANATRACKER_MIN_TRADES=20     # ...and at least this many closed trades (filters lucky 1-2 trade "100%")
# BIRDEYE_API_KEY=                # top traders by PnL via Birdeye (free key, no Cloudflare) — recommended
# BIRDEYE_TRACK_LIMIT=200         # how many top Birdeye wallets to source (paged 10/call)
# BIRDEYE_TIMEFRAMES=1W,today,yesterday  # timeframes to sweep + de-dupe for more coverage
# USE_ACTIVE_TRADERS=true         # keyless GeckoTerminal baseline — wallets actively buying trending tokens
# ACTIVE_MIN_USD=1000             # min buy size (USD) to source an active trader
# ACTIVE_POOLS=20                 # pools (trending + top-vol + new) to scan. Free tier is 30 req/min so calls are serialized ~2.2s; a run takes ~1 min
# GECKO_DELAY_MS=2200             # spacing between GeckoTerminal calls (>=2100 to stay under 30/min)
# USE_GMGN_WALLETS=false          # GMGN leaderboard — Cloudflare blocks datacenter IPs (403). Off by default; set true only to try
# GMGN_TRACK_LIMIT=100            # how many GMGN leaderboard wallets to source (if it works)
# Non-Solana chains push normalized events to POST /api/ingest/event (same INGEST_SECRET).

# ───────────── Auto-tweet channel (X / Twitter) — Moby-style, but STRICT ─────
# A deliberately QUIET auto-poster: it emits at most ONE strictly-gated tweet per
# dispatch tick, only for high-win-rate smart-money buys. Over-tweeting tanks
# reach, so the defaults under-post — loosen only if you know what you're doing.
# Leave the four keys blank to keep it in dry-run (composes + logs, never posts).
#
# Keys: developer.x.com → your app → give it "Read and Write", then regenerate
# the Access Token/Secret so they inherit write. OAuth 1.0a user context.
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# TWEET_INTERVAL_SEC=60             # how often the tweet worker CHECKS (it still under-posts)
#
# ── MOBY MODE — one switch for high frequency ──
# TWEET_MOBY_MODE=true             # post like Whale Watch by Moby: nearly every $1k+ tracked-wallet buy,
#                                  # NO mcap cap, no win-rate gate, ~1 tweet/min (up to 30/hr). Flips every
#                                  # default below; any individual TWEET_* var still overrides. Omit/false
#                                  # = the strict, quiet defaults shown below (protect X reach).
#
# ── Event-quality gate (a buy must clear ALL of these) — values below are the STRICT defaults ──
# TWEET_MIN_USD=5000               # min buy size to be tweet-worthy (>> the Telegram threshold)
# TWEET_MIN_LIQUIDITY_USD=20000    # thin liquidity = rug risk; skip
# TWEET_MIN_MCAP=100000            # skip dust
# TWEET_MAX_MCAP=50000000          # skip already-mooned caps (0 = no cap)
# TWEET_MIN_TOKEN_AGE_MIN=30       # skip <30-min-old tokens (applies only when age is known)
# TWEET_MAX_TOKEN_AGE_MIN=0        # 0 = no upper bound
# TWEET_REQUIRE_ANTIRUG_OK=true    # require a passing anti-rug verdict (blocks caution/unknown; a known rug is ALWAYS blocked)
#
# ── Wallet-quality gate (the smart-money filter) ──
# TWEET_MIN_WIN_RATE=60            # only wallets with >= this observed win-rate
# TWEET_MIN_CLOSED_TRADES=4        # min closed round-trips before the win-rate is trusted
# TWEET_STRICT_WINRATE=false       # true = require OBSERVED win-rate (no cold-start trust of leaderboard segment)
# TWEET_ALLOWED_SEGMENTS=smart,insider  # which segments may tweet (comma list; "*" = any)
#
# ── Selection + global rate limits (anti-spam) ──
# TWEET_MIN_CONVICTION=55          # 0-100; only tweet candidates at/above this conviction
# TWEET_MIN_SPACING_SEC=900        # min seconds between ANY two tweets (the core pacing lever)
# TWEET_MAX_PER_HOUR=4             # hard rolling-hour cap
# TWEET_MAX_PER_DAY=24             # hard rolling-day cap
# TWEET_TOKEN_COOLDOWN_MIN=1440    # don't re-tweet the same token within N min (any wallet). Default 24h so a token can't repeat in a day
# TWEET_PAIR_COOLDOWN_MIN=1440     # don't re-tweet the same wallet+token within N min
# TWEET_CANDIDATE_TTL_MIN=20       # drop queued candidates older than this
#
# ── Copy ──
# TWEET_STYLES=classic,alert,punchy,conviction,flow,fomo,minimal  # which copy styles to rotate through (default: all). See scripts/tweet-preview.mjs
# TWEET_WHALE_TAG=smart-money whale  # "A {tag} just bought $25K of $TOKEN at $2M MC"
# TWEET_SHOW_WINRATE=true          # append "· 75% win-rate wallet" when the stat is trusted
# TWEET_INCLUDE_CHART_LINK=false   # append a DexScreener link (links reduce reach — off by default)
# TWEET_SUFFIX=                    # optional trailing text (e.g. "via @apewise")
# TWEET_MIRROR_TELEGRAM=false      # OFF by default: sendAlert already posts every buy to the TG channel, so mirroring the tweeted pick would double-post the same token. Only enable if you disable the alert firehose.
# TWEETS_FILE=data/tweets.jsonl    # persisted post log (rate-limit state survives restarts)

# ── MODE B — Free no-Helius fallback: poll tracked wallets via public Solana RPC
# Run the worker:  pm2 start scripts/rpc-poll-worker.mjs --name apewise-rpc && pm2 save
# Smart-money swaps then flow in without a Helius webhook, at the cost of
# ~poll-interval latency. Tracks data/smart-wallets.json.
# ⚠️ Use a FREE public RPC here. This worker pulls EVERY wallet EVERY cycle, so a
#    paid Helius RPC burns credits on idle polling — if you have Helius, use the
#    webhook (Mode A) and `pm2 stop apewise-rpc` instead.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com  # FREE public RPC (or another free one)
# RPC_POLL_INTERVAL_SEC=30        # how often the worker polls all wallets
# RPC_SIGS_PER_WALLET=10          # newest signatures fetched per wallet per cycle (max 25)
# RPC_CALL_DELAY_MS=150           # spacing between RPC calls (stay under public-RPC limits)
# RPC_LOOKBACK_MIN=20             # on (re)start, surface swaps from the last N min immediately
# RPC_MAX_AGE_MIN=120             # ignore swaps older than this (ongoing staleness guard)
# RPC_MAX_WALLETS=60              # wallets polled PER CYCLE (the rotating window size)
# RPC_ROTATE_WALLETS=true         # cover a large set a window at a time across cycles (full coverage, bounded RPC load). Set false to always poll the first RPC_MAX_WALLETS
